# ── DATABASE ──────────────────────────────
DB_NAME=iree_db
DB_USER=iree_user
DB_PASSWORD=<your-db-password>

# ── CORS ──────────────────────────────────
# Origini autorizzate dal backend Spring (separate da virgola se più di una)
# In sviluppo: http://localhost:3000
# In produzione: URL del frontend su Azure
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── JWT (backend Spring) ──────────────────
# Secret HMAC-SHA256 a 256+ bit — genera con: openssl rand -base64 32
AUTH_JWT_SECRET=<generate-with-openssl-rand-base64-32>

# ── COOKIE httpOnly (BFF Next.js) ─────────
AUTH_ACCESS_TOKEN_COOKIE_NAME=iree_access_token
AUTH_ACCESS_TOKEN_COOKIE_PATH=/
AUTH_REFRESH_TOKEN_COOKIE_NAME=iree_refresh_token
AUTH_REFRESH_TOKEN_COOKIE_PATH=/

# ── API ───────────────────────────────────
# URL del frontend esposto pubblicamente (usato da Next.js lato client)
# In sviluppo: http://localhost:3000
# In produzione: URL del frontend su Azure
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# URL del backend chiamato dal BFF Next.js (server-side)
# In sviluppo: http://localhost:8080
# In produzione: URL del backend su Azure
API_URL=http://localhost:8080

# ── AZURE BLOB STORAGE ────────────────────
# Usata solo in produzione — in sviluppo l'override usa Azurite con stringa fissa.
# Recupera la connection string da: Azure Portal → Storage Account → Access keys
AZURE_STORAGE_CONNECTION_STRING=<your-azure-storage-connection-string>
AZURE_STORAGE_CONTAINER_NAME=iree-media
