# ── DATABASE ──────────────────────────────
DB_NAME=iree_db
DB_USER=iree_user
DB_PASSWORD=changeme

# ── API ───────────────────────────────────
# URL del backend chiamato dal frontend
# In sviluppo: http://localhost:8080
# In produzione: URL del backend su Azure
API_URL=http://localhost:8080

# ── AZURE BLOB STORAGE ────────────────────
# In sviluppo locale puoi usare Azurite (emulatore gratuito):
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# In produzione: connection string del vero Azure Storage
AZURE_STORAGE_CONNECTION_STRING=changeme
AZURE_STORAGE_CONTAINER_NAME=iree-media