# syntax=docker/dockerfile:1

FROM node:22-alpine
WORKDIR /app

# Abilita corepack: strumento incluso in Node 22 che gestisce
# pnpm, yarn e altri package manager alternativi a npm.
# Senza questa riga, il comando "pnpm" non esiste nel container.
RUN corepack enable

# Copia solo il file di lock e package.json per installare
# le dipendenze nell'immagine durante il build.
# I node_modules installati qui (per Linux/Alpine) vengono
# protetti dal volume anonimo in docker-compose.override.yml
# così non vengono sovrascritti da quelli del tuo PC.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# --frozen-lockfile: installa ESATTAMENTE le versioni in pnpm-lock.yaml
# senza aggiornare nulla — comportamento deterministico e sicuro
RUN pnpm install --frozen-lockfile

# NON copiamo il codice sorgente:
# arriva tramite bind mount da docker-compose.override.yml

EXPOSE 3000

CMD ["pnpm", "dev"]