# ============================================================================
# Instagram Clone - Environment Variables
# ============================================================================
# Copy this file to .env.local and adjust values as needed.
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=development

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://iree_user:iree_password_dev@localhost:5432/iree_db

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------
# URL del backend Spring — usato dal BFF Next.js per le chiamate server-side
SPRING_API_BASE_URL=http://localhost:8080

# Auth bypass: true = bypassa completamente l'autenticazione (solo sviluppo locale)
AUTH_BYPASS=false

# Nomi e path dei cookie httpOnly gestiti dal BFF
AUTH_ACCESS_TOKEN_COOKIE_NAME=iree_access_token
AUTH_ACCESS_TOKEN_COOKIE_PATH=/
AUTH_REFRESH_TOKEN_COOKIE_NAME=iree_refresh_token
AUTH_REFRESH_TOKEN_COOKIE_PATH=/
