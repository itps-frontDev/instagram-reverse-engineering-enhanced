# ============================================================================
# Instagram Clone - Environment Variables
# ============================================================================
# Copy this file to .env.local and adjust values as needed.
# This project uses SQLite, so no database credentials are needed!
# ============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
# The environment mode (development, production, test)
NODE_ENV=development

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------
# Secret key for signing JWT tokens (generate a random 32+ char string)
# IMPORTANT: Change this in production!
JWT_SECRET=your-super-secret-key-change-this-in-production-at-least-32-chars

# JWT token expiration time
JWT_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
# All files are stored locally in the `data/` directory:
# - data/instagram.db      - SQLite database
# - data/uploads/public/   - Publicly accessible media
# - data/uploads/private/  - Protected media (requires auth)
#
# No configuration needed - just ensure the data/ directory is writable.
