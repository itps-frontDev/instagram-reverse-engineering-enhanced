# ============================================================================
# Frontend (Next.js BFF) — Environment Variables
# ============================================================================
# Copia in .env.local per eseguire il frontend localmente (fuori Docker).
# In Docker le variabili vengono iniettate da docker-compose — non serve .env.local.
# ============================================================================

# ── DATABASE ──────────────────────────────
# Usata dal BFF per connettersi direttamente a PostgreSQL
DATABASE_URL=postgresql://iree_user:changeme@localhost:5432/iree_db

# ── BACKEND ───────────────────────────────
# URL del backend Spring — chiamate server-side dal BFF
# In sviluppo locale (fuori Docker): http://localhost:8080
# In Docker: sovrascritta da docker-compose (http://backend:8080)
SPRING_API_BASE_URL=http://localhost:8080

# ── AUTH BYPASS ───────────────────────────
# true = bypassa completamente l'autenticazione (solo sviluppo locale)
AUTH_BYPASS=false

# ── COOKIE httpOnly (BFF Next.js) ─────────
AUTH_ACCESS_TOKEN_COOKIE_NAME=iree_access_token
AUTH_ACCESS_TOKEN_COOKIE_PATH=/
AUTH_REFRESH_TOKEN_COOKIE_NAME=iree_refresh_token
AUTH_REFRESH_TOKEN_COOKIE_PATH=/

# ── URL PUBBLICI ──────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# URL del backend Spring esposto al browser (WebSocket SockJS)
NEXT_PUBLIC_WS_URL=http://localhost:8080
