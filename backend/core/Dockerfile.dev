# syntax=docker/dockerfile:1

# Usa l'immagine Gradle completa — serve il JDK intero per compilare con bootRun.
FROM gradle:8-jdk21-alpine
WORKDIR /app

# Il codice sorgente NON viene copiato nell'immagine.
# Arriva tramite bind mount da docker-compose.override.yml (./backend:/app).
# Per applicare le modifiche al codice: docker-compose restart core

EXPOSE 8081
EXPOSE 5005

CMD ["./gradlew", ":core:bootRun", \
     "--project-cache-dir", "/root/.gradle/project-cache", \
     "--args=--spring.profiles.active=dev"]
# --project-cache-dir sposta la cache Gradle fuori da /app/.gradle (bind mount condiviso
# con directs-service) per evitare deadlock su fileHashes.lock quando i due container
# partono contemporaneamente.