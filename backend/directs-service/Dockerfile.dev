# syntax=docker/dockerfile:1

# Basta il JDK: il CMD esegue ./gradlew (dal bind mount), cioè il wrapper,
# che scarica la versione di Gradle fissata in gradle-wrapper.properties.
FROM eclipse-temurin:21-jdk-alpine
WORKDIR /app

# Il codice sorgente NON viene copiato nell'immagine.
# Arriva tramite bind mount da docker-compose.override.yml (./backend:/app).
# Per applicare le modifiche al codice: docker-compose restart directs-service

EXPOSE 8082
EXPOSE 5006

# Il profilo dev arriva da SPRING_PROFILES_ACTIVE (docker-compose.override.yml),
# non va ripetuto qui con --args.
CMD ["./gradlew", ":directs-service:bootRun", \
     "--project-cache-dir", "/root/.gradle/project-cache"]
# --project-cache-dir sposta la cache Gradle fuori da /app/.gradle (bind mount condiviso
# con core) per evitare deadlock su fileHashes.lock quando i due container
# partono contemporaneamente.
